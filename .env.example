[TEMPLATE]
[TEMPLATE]
# Frontend env (Vite) — copy to .env for local development.
# Leave empty to run in all-local demo mode (localStorage only).
# Point at your API to enable the shared Neon-backed case store:
VITE_API_URL=http://localhost:8787

# Live updates: when VITE_API_URL is set, dashboards subscribe to the API's
# server-sent-events stream (GET /api/events) and refresh instantly when any
# device changes a case. No extra env var needed.

# OSRM routing instances (driving distances, ETAs, hospital matching).
# Optional: unset = use the public demo server only.
# Accepts ONE url or a COMMA-SEPARATED LIST, tried in order — put your own
# instance(s) first; the public server is appended as the safety net.
#VITE_OSRM_BASE_URL=http://localhost:5000
#
# Self-hosting (recommended for anything beyond demo traffic):
#   1. Download India/Maharashtra extract: https://download.geofabrik.de/asia/india.html
#   2. docker run -t -i -v "${PWD}:/data" osrm/osrm-backend osrm-extract -p /opt/car.lua /data/maharashtra-latest.osm.pbf
#   3. docker run -t -i -v "${PWD}:/data" osrm/osrm-backend osrm-contract /data/maharashtra-latest.osrm
#   4. docker run -t -i -p 5000:5000 osrm/osrm-backend osrm-routed --algorithm mld /data/maharashtra-latest.osrm
# (osrm-routed does not send CORS headers — put a tiny reverse proxy in front
#  that adds Access-Control-Allow-Origin for the app's origin.)
#
# Examples:
#VITE_OSRM_BASE_URL=http://localhost:5000
#VITE_OSRM_BASE_URL=https://osrm.mydomain.org,https://router.project-osrm.org
