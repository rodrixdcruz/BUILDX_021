[TEMPLATE]
# Copy to .env for local API development. NEVER commit real credentials.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
PORT=8787
# Comma-separated list of allowed frontend origins (* for local dev only)
ALLOWED_ORIGINS=http://localhost:5173

# Live updates (SSE): the API pushes case changes to browsers via
# GET /api/events. Change detection uses Postgres LISTEN/NOTIFY on the
# DIRECT (non-pooler) endpoint — the -pooler suffix is stripped from
# DATABASE_URL automatically. If the direct connection is unavailable the
# server falls back to a 5s changed-row poll; no extra env var needed.
